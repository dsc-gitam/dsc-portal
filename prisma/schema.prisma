// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String?
  image String?
  role  String @default("user") // user, admin
  
  applications RecruitmentApplication[]
  cloudStudyJamsRegistrations CloudStudyJamsRegistration[]
  interviewBookings InterviewBooking[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

model RecruitmentApplication {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal Information
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  
  // Academic Information
  studentId          String?
  yearOfStudy        String?
  branch             String?
  cgpa               String?
  
  // Role Selection
  selectedRole       String?
  
  // Technical Skills
  programmingLanguages String?
  githubProfile       String?
  linkedinProfile     String?
  
  // Motivation
  whyJoin            String?
  howContribute      String?
  
  // Experience
  previousExperience String?
  leadershipExperience String?
  
  // Technical Tasks
  selectedTask       String?
  taskSubmission     String?
  
  // Availability
  availability       String?
  hoursPerWeek       String?
  
  // Additional Information
  passionProject     String?
  challengeProposal  String?
  additionalInfo     String?
  
  // Application Status
  status             String @default("draft") // draft, submitted, under_review, shortlisted, rejected
  submittedAt        DateTime?
  shortlistedAt      DateTime?
  gender             String?
  
  interviewBooking   InterviewBooking?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("recruitment_applications")
}

model CloudStudyJamsRegistration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Registration Information
  email                   String?
  fullName                String?
  gender                  String?
  graduationYear          String?
  hasLaptop               String?
  newAccountVerified      String?
  skillsBoostEmail        String?
  profileUrl              String?
  
  // Acknowledgements
  termsAccepted           String?
  dataAcknowledgement     String?
  completionAgreement     String?
  
  // Application Status
  status                  String @default("draft") // draft, submitted, shortlisted, rejected
  submittedAt             DateTime?
  shortlistedAt           DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("cloud_study_jams_registrations")
}

model InterviewSlot {
  id          String @id @default(cuid())
  date        DateTime
  startTime   String
  endTime     String
  venue       String
  isAvailable Boolean @default(true)
  
  bookings    InterviewBooking[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("interview_slots")
}

model InterviewBooking {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  applicationId String @unique
  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  slotId        String
  slot          InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  
  status        String @default("confirmed") // confirmed, completed, cancelled
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("interview_bookings")
}
